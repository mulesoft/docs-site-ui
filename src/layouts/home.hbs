<!DOCTYPE html>
<html lang={{#if (eq (site-profile) 'jp' )}}"jp"{{else}}"en"{{/if}}>

<head>
    <title>{{{detag (or page.title 'Untitled')}}}{{#if site.title}} {{#if (not (is-one-of (site-profile) 'archive' 'jp' 'prod'))}}| {{{capitalize (site-profile)}}}{{/if}}{{/if}}</title>
    {{> head}}
</head>

<body class="flex col home">
    {{> header}}
    {{> top-banner}}
    <div class="flex container wrapper">
        {{> nav}}
        {{#if (eq (site-profile) 'archive' )}}
            {{> toc}}
        {{/if}}
        <main class="main" id="landing-page" data-ceiling="topbar">
            {{> toolbar}}
            {{> notice-banner}}
        {{#if (eq (site-profile) 'archive' )}}
            <div id="archive-homepage">
            {{> article}}
            </div>
        {{else}}
            {{> landing-page}}
        {{/if}}
        </main>
    </div>
    {{> footer}}
    <button id="dark-mode-toggle" class="dark-mode-toggle dark-mode-toggle-fab" aria-label="Switch to dark mode" aria-pressed="false" data-ui-root="{{@root.uiRootPath}}">
      <img loading="lazy" src="{{@root.uiRootPath}}/img/icons/dark-mode.svg" alt="Moon icon" width="20" height="20">
    </button>
</body>

</html>

<script>
  const localFiles = window.location.hostname === '';
  if (localFiles) {
    const staticOrigin = new URL('{{siteRootPath}}/', window.location.href).href;
    document.querySelectorAll('hgf-c360nav, hgf-footer').forEach((element) => {
      element.setAttribute('origin', staticOrigin);
    });
  }

  const navScript = document.createElement('script');
  navScript.type = 'module';
  navScript.src = localFiles
    ? '{{siteRootPath}}/digital/xsf/components/v1-stable/navs.js'
    : '{{#if (eq (site-profile) 'preview')}}{{siteRootPath}}/digital/xsf/components/v1-stable/navs.js{{else}}https://a.sfdcstatic.com/digital/xsf/components/v1-stable/navs.js{{/if}}';
  document.head.appendChild(navScript);

  window.SfdcWwwBase = window.SfdcWwwBase || {};
  window.SfdcWwwBase.gdpr = window.SfdcWwwBase.gdpr || {
    preference: function () {
      if (typeof OneTrust !== 'undefined' && OneTrust.ToggleInfoDisplay) {
        OneTrust.ToggleInfoDisplay();
      }
    }
  };
</script>
{{#unless (eq (site-profile) 'preview')}}
<script>
  const bottomScript = document.createElement('script');
  bottomScript.defer = true;
  bottomScript.src = window.location.hostname === ''
    ? '{{siteRootPath}}/digital/@sfdc-www/clientlibs-web-components/v1-stable/bottom.js'
    : 'https://a.sfdcstatic.com/digital/@sfdc-www/clientlibs-web-components/v1-latest/bottom.js';
  document.head.appendChild(bottomScript);
</script>
{{/unless}}
